{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "sonnet-3.5-sonnet",
  "plansDirectory": "./.claude/plans", 
  "permissions": {
    "defaultMode": "plan",
    "allow": [
      "Bash"
    ],
    "ask" : [],
    "deny": [
      "Bash(curl *)",
      "Read(./.env)",
      "Read(../.env)",
      "Bash(git push *)"
    ]
  },
  "outputStyle": "Explanatory",
  "advisoryMode": true,
  "advisoryModeMessage": "You are in advisory mode. You will only provide advice and suggestions, but not execute commands.",
  "advisorModel": "opus-3.5-sonnet",
  "language": "ko"
}
