@Library('runBatchJob') _
import java.time.ZoneId
import java.time.LocalDate
import java.time.format.DateTimeFormatter

pipeline {
    agent any

    options {
        timeout(time: 10, unit: 'MINUTES')
    }

    environment {
        SG = credentials('ecs-sg')
        SUBNETS = credentials('ecs-subnets-a')
    }

    stages {

        stage('getTargetDate') { steps { script {
            env.YESTERDAY = LocalDate.now(ZoneId.of('Asia/Seoul')).minusDays(1)
                            .format(DateTimeFormatter.ISO_LOCAL_DATE)
        } } }

        stage('batch') { parallel {
            stage('dailySales') {
                steps { script {
                    try { runBatchJob('syncDailySalesJob') }
                    catch (e) {
                        try { runBatchJob('retryDailySalesSyncJob') }
                        catch (retryEx) { error("dailySales sync/retry 모두 실패: ${retryEx.message}") }
                    }
                } }
            }

            stage('closingAttendance') { steps {
                runBatchJob('closingAttendanceJob', ["attendanceDate=${env.YESTERDAY}"])
            } }

            stage('cleanUpChatRoom')   { steps {
                runBatchJob('cleanUpChatRoomJob', ["cleanUpDate=${env.YESTERDAY}"])
            } }
        }}

    }

    post {
        failure {
           echo '배치 파이프라인 실패 — 실패한 스테이지 로그 확인'
        }
    }
}